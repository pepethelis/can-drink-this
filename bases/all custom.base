views:
  - type: table
    name: own
    filters:
      and:
        - file.folder == "content/reviews/own"
    order:
      - file.name
      - related
    sort:
      - property: file.size
        direction: DESC
  - type: table
    name: subscribers
    filters:
      and:
        - file.folder == "content/reviews/subscribers"
  - type: table
    name: friendly
    filters:
      and:
        - file.folder.startsWith("content/reviews/friendly")
        - types.isEmpty()
  - type: table
    name: all
    filters:
      and:
        - file.folder.startsWith("content/reviews")
    order:
      - file.name
      - volume
      - taste
      - alco
    sort:
      - property: alco
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.taste: 205
