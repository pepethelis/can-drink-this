views:
  - type: table
    name: own
    filters:
      and:
        - "!author.isEmpty()"
    groupBy:
      property: author
      direction: ASC
    order:
      - file.name
      - author
    sort:
      - property: file.size
        direction: DESC
  - type: table
    name: subscribers
    filters:
      and:
        - file.folder == "content/reviews/subscribers"
  - type: table
    name: friendly
    filters:
      and:
        - file.folder.startsWith("content/reviews/friendly")
        - types.isEmpty()
  - type: table
    name: all
    filters:
      and:
        - file.folder.startsWith("content/reviews")
    order:
      - file.name
      - externalUrl
    sort:
      - property: alco
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.taste: 205
