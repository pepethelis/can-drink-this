filters:
  and:
    - file.folder == "content/reviews/own"
formulas:
  Untitled: if(cover, "", "no cover")
views:
  - type: cards
    name: All (cards)
    order:
      - file.name
      - taste
      - type
    cardSize: 210
    image: note.cover
    imageAspectRatio: 1
    imageFit: ""
  - type: cards
    name: With covers
    filters:
      and:
        - and:
            - "!cover.isEmpty()"
            - cover != link("default.png")
    cardSize: 110
    image: note.cover
  - type: table
    name: Without covers
    filters:
      or:
        - cover.isEmpty()
        - cover == link("default.png")
    cardSize: 210
    image: note.cover
  - type: table
    name: By status
    groupBy:
      property: type
      direction: ASC
