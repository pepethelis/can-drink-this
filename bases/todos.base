filters:
  and:
    - file.folder.startsWith("content/reviews/own")
views:
  - type: table
    name: createdAt date
    filters:
      and:
        - createdAt.isEmpty()
        - cover != link("default.png")
        - publishedAt >= "2026-04-01"
    order:
      - file.name
      - cover
      - createdAt
    sort:
      - property: publishedAt
        direction: DESC
    columnSize:
      file.name: 167
      note.cover: 124
