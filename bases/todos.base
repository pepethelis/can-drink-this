filters:
  and:
    - file.folder.startsWith("content/reviews/own")
formulas:
  Untitled: image(cover)
views:
  - type: table
    name: Table
    filters:
      and:
        - createdAt.isEmpty()
        - cover != link("default.png")
    order:
      - file.name
      - cover
      - createdAt
      - formula.Untitled
