filters:
  and:
    - file.folder.startsWith("content/reviews/own")
views:
  - type: table
    name: createdAt date
    filters:
      and:
        - createdAt.isEmpty()
        - cover != link("default.png")
    order:
      - file.name
      - cover
      - createdAt
    sort:
      - property: publishedAt
        direction: DESC
