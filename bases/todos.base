filters:
  and:
    - file.folder.startsWith("content/reviews/own")
formulas:
  Untitled: file.content.contains("\n\n")
properties:
  formula.Untitled:
    displayName: Contains \n\n
views:
  - type: table
    name: createdAt date
    filters:
      and:
        - createdAt.isEmpty()
        - cover != link("default.png")
    order:
      - file.name
      - cover
      - createdAt
    sort:
      - property: publishedAt
        direction: DESC
  - type: table
    name: new formatting
    order:
      - file.name
      - formula.Untitled
