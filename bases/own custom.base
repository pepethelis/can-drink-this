filters:
  and:
    - file.folder == "content/reviews/own"
views:
  - type: table
    name: Таблиця
    filters:
      and:
        - brand.startsWith("monster")
    order:
      - file.name
      - createdAt
      - publishedAt
    sort:
      - property: createdAt
        direction: DESC
      - property: file.mtime
        direction: DESC
