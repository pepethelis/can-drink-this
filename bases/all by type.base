filters:
  and:
    - file.folder.startsWith("content/reviews")
views:
  - type: table
    name: all
    sort: []
  - type: table
    name: alco
    filters:
      and:
        - types.containsAny("alco")
  - type: table
    name: alco-energy
    filters:
      and:
        - types.containsAll("alco", "energy")
  - type: table
    name: ayran
    filters:
      and:
        - types.containsAny("ayran")
  - type: table
    name: coffee
    filters:
      and:
        - types.containsAny("coffee")
  - type: table
    name: energy
    filters:
      and:
        - types.containsAny("energy")
  - type: table
    name: energy coffee
    filters:
      and:
        - types == ["energy","coffee"]
  - type: table
    name: energy kombucha
    filters:
      and:
        - types == ["energy","kombucha"]
  - type: table
    name: energy tea
    filters:
      and:
        - types == ["energy","tea"]
  - type: table
    name: fizzy
    filters:
      and:
        - types.containsAny("fizzy")
  - type: table
    name: juice
    filters:
      and:
        - types.containsAny("juice")
  - type: table
    name: kombucha
    filters:
      and:
        - types.containsAny("kombucha")
  - type: table
    name: kvass
    filters:
      and:
        - types.containsAny("kvass")
  - type: table
    name: plant-based
    filters:
      and:
        - types.containsAny("plant-based")
  - type: table
    name: tea
    filters:
      and:
        - types.containsAny("tea")
  - type: table
    name: water
    filters:
      and:
        - types.containsAny("water")
  - type: table
    name: yogurt
    filters:
      and:
        - types.containsAny("yogurt")
