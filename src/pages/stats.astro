---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import StatsCharts from "@/components/StatsCharts";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import postFilter from "@/utils/postFilter";
import getReviewStats from "@/utils/getReviewStats";

const allReviews = await getCollection("reviews", ({ data }) =>
  postFilter({ data })
);
const allReviewsIncludingUnpublished = await getCollection("reviews");
const sorted = getSortedPosts(allReviews);

const allStats = getReviewStats(sorted, allReviewsIncludingUnpublished);
const ownReviews = sorted.filter(r => r.data.category === "власні огляди");
const ownCreationReviews = allReviewsIncludingUnpublished.filter(
  r => r.data.category === "власні огляди"
);
const ownStats = getReviewStats(ownReviews, ownCreationReviews);

const reviewsUrl = import.meta.env.BASE_URL.replace(/\/$/, "") + "/reviews";
---

<Layout title={`Stats | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Statistics" pageDesc="Aggregate data across all reviews.">
    <!-- Charts (React + Recharts) -->
    <StatsCharts
      client:load
      allStats={allStats}
      ownStats={ownStats}
      reviewsUrl={reviewsUrl}
    />
  </Main>
  <Footer />
</Layout>

<style is:global>
  .chart-card {
    border-radius: 0.5rem;
    background-color: color-mix(in srgb, var(--muted) 40%, transparent);
    padding: 1rem 1.25rem;
  }
  .chart-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin-bottom: 0.75rem;
  }
</style>
