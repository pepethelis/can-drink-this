---
import { getImage } from "astro:assets";
import {
  normalizeMediaLink,
  resolveImageAsset,
  resolveVideoSrc,
  isVideo,
} from "@/utils";
import type { ImageMetadata } from "astro";

type ImageItem = ImageMetadata | string;

type Props = {
  images?: ImageItem[];
};

type GalleryItem =
  | { kind: "video"; src: string }
  | {
      kind: "image";
      src: string;
      srcset?: string;
      sizes?: string;
      width?: number;
      height?: number;
    };

const { images = [] } = Astro.props;

const cleanImages = images.filter(Boolean) as ImageItem[];

// Load all video assets in the blog directory. `?url` keeps every matching
// file in the build, which is fine for videos (there are none today) but must
// not be used for images — see below.
const videoAssets = import.meta.glob("/src/data/**/*.{mp4,webm,ogg}", {
  eager: true,
  query: "?url",
  import: "default",
});

// Plain import (no `?url`) gives ImageMetadata without telling Astro to keep
// the original file. A `?url` glob here used to ship every phone photo in
// src/data untouched and pushed the site over the 1 GB GitHub Pages limit.
const imageAssets = import.meta.glob(
  "/src/data/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
  { eager: true, import: "default" }
);

// Carousel images are shown 320px tall (h-80); render them for 2x screens.
const CAROUSEL_HEIGHT = 640;
// A single image spans the content column (max-h-130).
const SINGLE_WIDTHS = [800, 1600];
const SINGLE_SIZES = "(min-width: 768px) 768px, 100vw";

// Never read `meta.src` here: in Astro that getter marks the original file as
// used and copies it into dist. getImage() reads it untracked.
const optimize = async (
  meta: ImageMetadata,
  single: boolean
): Promise<GalleryItem> => {
  if (meta.format === "svg" || meta.format === "gif") {
    // Vector / possibly animated: ship the original on purpose (reading
    // `.src` keeps it in dist). There are none in content/assets today.
    return {
      kind: "image",
      src: meta.src,
      width: meta.width,
      height: meta.height,
    };
  }

  if (single) {
    const widths = [
      ...new Set(SINGLE_WIDTHS.map(w => Math.min(w, meta.width))),
    ];
    // `width` sets the fallback `src` (and width/height attributes); without
    // it getImage keeps the original dimensions for `src`.
    const width = Math.max(...widths);
    const img = await getImage({
      src: meta,
      width,
      height: Math.round((meta.height / meta.width) * width),
      widths,
      sizes: SINGLE_SIZES,
      format: "webp",
      quality: 80,
    });
    return {
      kind: "image",
      src: img.src,
      srcset: img.srcSet.attribute || undefined,
      sizes: SINGLE_SIZES,
      width: Number(img.attributes.width) || meta.width,
      height: Number(img.attributes.height) || meta.height,
    };
  }

  const height = Math.min(CAROUSEL_HEIGHT, meta.height);
  const width = Math.round((meta.width / meta.height) * height);
  const img = await getImage({
    src: meta,
    width,
    height,
    format: "webp",
    quality: 80,
  });
  return { kind: "image", src: img.src, width, height };
};

const toGalleryItem = async (
  image: ImageItem,
  single: boolean
): Promise<GalleryItem> => {
  if (typeof image !== "string") return optimize(image, single);

  const normalized = normalizeMediaLink(image);
  if (isVideo(normalized)) {
    return { kind: "video", src: resolveVideoSrc(normalized, videoAssets) };
  }

  const resolved = resolveImageAsset(normalized, imageAssets);
  if (resolved && typeof resolved !== "string") {
    return optimize(resolved, single);
  }
  // External URL, absolute path, or a file that doesn't exist: as before.
  return { kind: "image", src: resolved ?? normalized };
};

const single = cleanImages.length === 1;
const items = await Promise.all(
  cleanImages.map(image => toGalleryItem(image, single))
);
---

{
  items.length > 1 && (
    <section
      class:list={[
        "mb-6 flex max-h-80 gap-3 overflow-x-auto rounded-lg",
        "scrollbar-thin scrollbar-thumb-muted scrollbar-track-transparent",
      ]}
    >
      {items.map((item, index) =>
        item.kind === "video" ? (
          <video
            src={item.src}
            controls
            preload="metadata"
            class="h-80 max-h-80 w-auto rounded-lg object-cover"
          />
        ) : (
          <img
            src={item.src}
            width={item.width}
            height={item.height}
            alt=""
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            class="h-80 max-h-80 w-auto rounded-lg object-cover"
          />
        )
      )}
    </section>
  )
}

{
  items.length === 1 && (
    <div class="mb-6">
      {items[0].kind === "video" ? (
        <video
          src={items[0].src}
          controls
          preload="metadata"
          class="w-full rounded-lg object-cover"
        />
      ) : (
        <img
          src={items[0].src}
          srcset={items[0].srcset}
          sizes={items[0].srcset ? items[0].sizes : undefined}
          width={items[0].width}
          height={items[0].height}
          alt=""
          decoding="async"
          class="max-h-130 w-full rounded-lg object-cover"
        />
      )}
    </div>
  )
}
